# MCP-сервер графиков отключений
# Секрет в URL: https://<host>/mcp/<MCP_SECRET>. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_SECRET=
# http (по умолчанию) или stdio (для Claude Desktop на этом же компьютере)
MCP_TRANSPORT=http
PORT=8000
# Домен сервера через запятую, включает защиту по Host-заголовку. Пусто = выключено.
MCP_ALLOWED_HOSTS=
LOG_LEVEL=INFO
